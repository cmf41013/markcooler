{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server (TS)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/server/src/index.ts",
      "args": ["serve", "--no-open"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web"
    }
  ]
}
